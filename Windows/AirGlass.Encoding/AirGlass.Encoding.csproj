<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <UseWindowsDesktop>true</UseWindowsDesktop>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- For MediaFoundation interop -->
        <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" Version="3.1.0" />

        <!-- SharpDX for Media Foundation -->
        <PackageReference Include="SharpDX" Version="4.2.0" />
        <PackageReference Include="SharpDX.MediaFoundation" Version="4.2.0" />
        <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AirGlass.Capture\AirGlass.Capture.csproj" />
    </ItemGroup>

</Project>
