<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification area (tray) icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- WPF and Windows Forms share type names; usings are explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>AirGlass</AssemblyName>
    <RootNamespace>AirGlass</RootNamespace>
    <ApplicationIcon>Assets\AirGlass.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>0.2.0</Version>
    <Product>AirGlass</Product>
    <Company>Lupusoft</Company>
    <Copyright>© 2026 Lupusoft</Copyright>
    <Description>Mirror your screen to a phone on the same Wi-Fi.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\*.ico" />
  </ItemGroup>

  <!-- The phone-side viewer page, shared with the macOS app. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Viewer\*" LogicalName="Viewer/%(Filename)%(Extension)"
                      Link="Viewer\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

</Project>
