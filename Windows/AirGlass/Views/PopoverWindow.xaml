<Window x:Class="AirGlass.Views.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirGlass"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource UIFont}">

  <!-- The popover from the AirGlass design: 260 pt wide, 10/8/6 pt padding,
       10 pt between rows. The outer margin leaves room for the shadow. -->
  <Grid Margin="24">
    <Border CornerRadius="18" Background="{DynamicResource PanelBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270"
                          Color="{DynamicResource ShadowColor}" Opacity="1" />
      </Border.Effect>
    </Border>

    <Border Width="260" CornerRadius="18" Padding="8,10,8,6"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0.5">
      <StackPanel>

        <!-- Header: logo, name, status -->
        <Grid Height="26" Margin="4,2,4,10">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="16.3" Height="15">
              <ContentControl Content="{StaticResource LogoCanvas}" />
            </Viewbox>
            <TextBlock Text="AirGlass" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" StrokeThickness="1.5"
                     Stroke="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="Bekliyor" Margin="6,0,0,0" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- 1 · Waiting: QR card, copy link, source -->
        <StackPanel x:Name="WaitingPanel">
          <Border Margin="4,0,4,10" Padding="0,14,0,12" CornerRadius="14"
                  Background="{DynamicResource CardBrush}">
            <StackPanel HorizontalAlignment="Center">
              <!-- Always white, even in dark mode, so phone cameras read it reliably. -->
              <Border Background="White" CornerRadius="12" Padding="10" HorizontalAlignment="Center"
                      BorderBrush="#14000000" BorderThickness="0.5">
                <Image x:Name="QrImage" Width="148" Height="148"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
              </Border>
              <TextBlock Text="Telefonunun kamerasıyla okut" Margin="0,10,0,0" HorizontalAlignment="Center"
                         FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" />
              <TextBlock x:Name="HostText" Margin="0,2,0,0" HorizontalAlignment="Center"
                         FontFamily="{DynamicResource MonoFont}" FontSize="11"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
          </Border>

          <Button x:Name="CopyButton" Style="{StaticResource ControlButton}" Margin="4,0,4,10"
                  Click="OnCopyLink">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="CopyIcon" Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                         VerticalAlignment="Center" Margin="0,1,6,0" />
              <TextBlock x:Name="CopyText" Text="Linki kopyala" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Rectangle Style="{StaticResource SeparatorLine}" />
          <TextBlock Text="Kaynak" Style="{StaticResource SectionLabel}" />
          <!-- "Tüm ekran / Pencere seç" -->
          <Border Margin="4,0,4,10" Padding="2" CornerRadius="8" Background="{DynamicResource SegmentTrackBrush}">
            <UniformGrid Columns="2">
              <ToggleButton x:Name="FullScreenSegment" Content="Tüm ekran" Margin="0,0,1,0"
                            Style="{StaticResource SegmentButton}" Click="OnFullScreenSegment" />
              <ToggleButton x:Name="WindowSegment" Content="Pencere seç" Margin="1,0,0,0"
                            Style="{StaticResource SegmentButton}" Click="OnWindowSegment" />
            </UniformGrid>
          </Border>
          <!-- What is being captured, with Değiştir… / Durdur -->
          <StackPanel x:Name="WaitingCapturePanel" Visibility="Collapsed">
            <Grid Margin="4,0,4,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource ControlBrush}">
              <Path x:Name="WaitingSourceIcon" Width="15" Height="15" Stretch="None" StrokeThickness="1.2"
                    Stroke="{DynamicResource TextBrush}" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="WaitingSourceName" FontSize="13" FontWeight="Medium"
                         Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="WaitingSourceKind" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
          </Grid>
            <UniformGrid Columns="2" Margin="4,0,4,10">
              <Button Style="{StaticResource ControlButton}" Height="24" Margin="0,0,3,0" Click="OnChangeSource">
                <TextBlock Text="Değiştir…" />
              </Button>
              <Button Style="{StaticResource ControlButton}" Height="24" Margin="3,0,0,0"
                      Foreground="{DynamicResource RedBrush}" Click="OnStopCapture">
                <TextBlock Text="Durdur" />
              </Button>
            </UniformGrid>
          </StackPanel>
          <TextBlock x:Name="CaptureFailedText" Visibility="Collapsed" Margin="4,0,4,10" FontSize="11"
                     TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <!-- 2 · Connected: device card, what is shown, disconnect -->
        <StackPanel x:Name="ConnectedPanel" Visibility="Collapsed">
          <Border Margin="4,0,4,10" Padding="12,14,12,14" CornerRadius="14"
                  Background="{DynamicResource CardBrush}">
            <StackPanel Orientation="Horizontal">
              <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource AccentFillBrush}" />
                <TextBlock Text="&#xE8EA;" FontFamily="{DynamicResource IconFont}" FontSize="18"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="DeviceText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" />
                  <TextBlock x:Name="DeviceAddressText" Margin="5,0,0,0" FontSize="11"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="Yayınlanan" Style="{StaticResource SectionLabel}" />
          <StackPanel x:Name="ConnectedSourcePanel" Visibility="Collapsed">
            <Grid Margin="4,0,4,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource ControlBrush}">
              <Path x:Name="ConnectedSourceIcon" Width="15" Height="15" Stretch="None" StrokeThickness="1.2"
                    Stroke="{DynamicResource TextBrush}" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="ConnectedSourceName" FontSize="13" FontWeight="Medium"
                         Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ConnectedSourceKind" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
          </Grid>
          </StackPanel>
          <!-- "Tüm ekran / Pencere seç" -->
          <Border x:Name="ConnectedPicker" Margin="4,0,4,10" Padding="2" CornerRadius="8" Background="{DynamicResource SegmentTrackBrush}">
            <UniformGrid Columns="2">
              <ToggleButton x:Name="ConnectedFullScreenSegment" Content="Tüm ekran" Margin="0,0,1,0"
                            Style="{StaticResource SegmentButton}" Click="OnFullScreenSegment" />
              <ToggleButton x:Name="ConnectedWindowSegment" Content="Pencere seç" Margin="1,0,0,0"
                            Style="{StaticResource SegmentButton}" Click="OnWindowSegment" />
            </UniformGrid>
          </Border>

          <Button Style="{StaticResource ControlButton}" Height="32" Margin="4,2,4,10"
                  Background="{DynamicResource RedBrush}" Foreground="White" Click="OnDisconnect">
            <TextBlock Text="Bağlantıyı kes" />
          </Button>
        </StackPanel>

        <!-- 4 · No network -->
        <Border x:Name="OfflinePanel" Visibility="Collapsed" Margin="4,0,4,10" Padding="0,14,0,12"
                CornerRadius="14" Background="{DynamicResource CardBrush}">
          <StackPanel HorizontalAlignment="Center">
            <Grid Width="168" Height="168">
              <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="2.67 2"
                         Stroke="{DynamicResource SeparatorBrush}" />
              <StackPanel VerticalAlignment="Center" Margin="12">
                <!-- wifi.slash -->
                <Canvas Width="26" Height="22" HorizontalAlignment="Center">
                  <Path Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 2.5,9.5 A 14.85,14.85 0 0 1 23.5,9.5 M 6.5,13.5 A 9.2,9.2 0 0 1 19.5,13.5 M 10.2,17.2 A 3.96,3.96 0 0 1 15.8,17.2 M 4,1.5 L 22,20.5" />
                  <Ellipse Canvas.Left="11.5" Canvas.Top="19" Width="3" Height="3"
                           Fill="{DynamicResource SecondaryTextBrush}" />
                </Canvas>
                <TextBlock x:Name="OfflineText" Margin="0,12,0,0" FontSize="13" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
              </StackPanel>
            </Grid>
            <TextBlock Margin="16,10,16,0" Width="196" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Bilgisayar ve telefon aynı ağa bağlandığında QR kod burada görünür." />
          </StackPanel>
        </Border>

        <Rectangle Style="{StaticResource SeparatorLine}" />

        <!-- Menu rows sit together, without the 10 pt row spacing. -->
        <StackPanel>
          <Button Style="{StaticResource MenuRow}" Click="OnAbout">
            <TextBlock Text="AirGlass Hakkında" />
          </Button>
          <Button Style="{StaticResource MenuRow}" Click="OnQuit">
            <Grid>
              <TextBlock Text="Çıkış" />
              <TextBlock Text="Ctrl+Q" HorizontalAlignment="Right" FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>
          </Button>
        </StackPanel>

      </StackPanel>
    </Border>
  </Grid>
</Window>
